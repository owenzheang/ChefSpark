DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional; defaults to deepseek-flash.
DEEPSEEK_MODEL=deepseek-flash
JWT_SECRET=your_secure_jwt_secret_here

# Optional AI Zine artwork (off unless ZINE_GENERATION_ENABLED=true). Each creation is one paid OpenAI request.
ZINE_GENERATION_ENABLED=false
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium
ZINE_USER_DAILY_LIMIT=3
ZINE_GLOBAL_DAILY_LIMIT=30

# Recipe assistant (Phase 3, DeepSeek). Off unless true; daily request limits per user and in total.
ASSISTANT_ENABLED=false
ASSISTANT_USER_DAILY_LIMIT=20
ASSISTANT_GLOBAL_DAILY_LIMIT=300

# Food pictures (Phase 4, OpenAI, uses OPENAI_API_KEY above). Off unless true. Each new picture is one paid
# request; pictures are shared through a library, so a dish already pictured costs nothing.
FOOD_IMAGES_ENABLED=false
# low or medium (1024x1024 WebP).
FOOD_IMAGE_QUALITY=low
# Per user per day: pictures for planned dishes (2 menus x 3 dishes) and for accepted variations.
FOOD_IMAGE_MENU_DAILY_LIMIT=6
FOOD_IMAGE_VARIANT_DAILY_LIMIT=2
FOOD_IMAGE_GLOBAL_DAILY_LIMIT=100
